{% sw_extends '@Storefront/storefront/base.html.twig' %}
{% block base_header %}
<div class="ay-announcement">THE NEW PERSPECTIVE &nbsp; · &nbsp; Deine Garderobe beginnt bei dir.</div>
<header class="ay-header"><a class="ay-logo" href="/">ATELIER<span>/ YOU</span><small>PERSONAL EDITION</small></a><nav><a href="/#collection">Die Kollektion</a><a href="/?outfit=1">Outfit Studio <sup>NEW</sup></a><a href="/#how">So funktioniert’s</a></nav><button class="ay-personal" data-upload-open><span class="ay-dot"></span><span data-profile-label>Deine Anprobe</span><span>↗</span></button></header>
{% endblock %}
{% block base_navigation %}{% endblock %}
{% block base_main %}
{% if page.product is defined or app.request.attributes.get('_route') == 'frontend.home.page' %}
<main id="content-main" class="ay-main" data-product-id="{{ page.product.id|default('') }}" data-outfit="{{ app.request.query.get('outfit') == '1' ? 'true' : 'false' }}">
{% if app.request.query.get('outfit') == '1' %}
<div class="ay-breadcrumb"><a href="/">Kollektion</a><span>/</span>Outfit Studio</div>
<section class="ay-pdp ay-outfit-studio"><div class="ay-product-visual"><img id="ay-main-image" alt="Dein Outfit"><img id="ay-incoming-image" alt="Dein neues Outfit"><div class="ay-magic" aria-hidden="true"><div class="ay-magic-light"></div><div class="ay-magic-line"></div><i>✧</i><i>✧</i><i>✦</i></div><div class="ay-image-label"><span class="ay-dot"></span><span id="ay-image-state">DEIN OUTFIT STUDIO</span></div><button class="ay-compare" id="ay-compare" hidden>Original ansehen ↔</button><div class="ay-render-state" id="ay-render-state" hidden><span class="ay-spinner"></span><span>Dein Outfit entsteht …</span></div></div><div class="ay-product-info"><p class="ay-eyebrow">MEHR ALS EIN EINZELNER LOOK</p><h1>Alles passt.<br>Zu dir.</h1><p class="ay-description">Stelle deinen Look zusammen. Ein Oberteil, die richtige Hose, deine Schuhe — und alles gemeinsam an dir.</p><div id="ay-outfit-selectors"></div><div class="ay-outfit-total"><span>Dein Outfit</span><b id="ay-outfit-price"></b></div><button class="ay-primary" id="ay-outfit-generate">Outfit an mir ansehen <span>✧</span></button><p class="ay-note" id="ay-personal-note">Wähle bis zu fünf Teile für deinen Look.</p><div class="ay-angles" id="ay-angles" hidden><p class="ay-small-title">DEIN OUTFIT · AUS JEDER PERSPEKTIVE</p><div><button class="selected" data-view="front">Vorne</button><button data-view="side">Seite <span>✧</span></button><button data-view="back">Hinten <span>✧</span></button></div><small>Zusätzliche Ansichten sind KI-generierte Interpretationen.</small></div><p class="ay-note">Evaluationskollektion · KI-Visualisierung, keine Passformmessung</p></div></section>
{% elseif page.product is defined %}
<div class="ay-breadcrumb"><a href="/">Kollektion</a><span>/</span>{{ page.product.translated.name }}</div>
<section class="ay-pdp"><div class="ay-product-visual"><img id="ay-main-image" src="{{ page.product.cover.media.url }}" alt="{{ page.product.translated.name }}"><img id="ay-incoming-image" alt="Deine persönliche Anprobe"><div class="ay-magic" aria-hidden="true"><div class="ay-magic-light"></div><div class="ay-magic-line"></div><i>✧</i><i>✧</i><i>✦</i></div><div class="ay-image-label"><span class="ay-dot"></span><span id="ay-image-state">THE ORIGINAL</span></div><button class="ay-compare" id="ay-compare" hidden>Original ansehen ↔</button><div class="ay-render-state" id="ay-render-state" hidden><span class="ay-spinner"></span><span>Dein Look entsteht …</span></div></div>
<div class="ay-product-info"><p class="ay-eyebrow">ATELIER ESSENTIALS · EDITION 01</p><h1>{{ page.product.translated.name }}</h1><p class="ay-price">{{ page.product.calculatedPrice.unitPrice|number_format(2, ',', '.') }} €</p><p class="ay-description">{{ page.product.translated.description|striptags }}</p><div class="ay-divider"></div><p class="ay-small-title">DEINE PERSPEKTIVE</p><button class="ay-try-button" data-upload-open><span>✧</span><span id="ay-try-label">An mir ansehen</span><span>↗</span></button><p class="ay-note" id="ay-personal-note">Ein Foto. Die ganze Kollektion. Ganz du.</p><p class="ay-small-title ay-size-title">GRÖSSE <span>Demo-Kollektion</span></p><div class="ay-sizes"><button>S</button><button class="selected">M</button><button>L</button><button>XL</button></div><div class="ay-angles" id="ay-angles" hidden><p class="ay-small-title">DEIN LOOK · AUS JEDER PERSPEKTIVE</p><div><button class="selected" data-view="front">Vorne</button><button data-view="side">Seite <span>✧</span></button><button data-view="back">Hinten <span>✧</span></button></div><small>Zusätzliche Ansichten sind KI-generierte Interpretationen.</small></div><div class="ay-shop-note">Shopware Demo · Keine Bestellannahme</div><div class="ay-benefits"><span>01 &nbsp; Zeitloses Design</span><span>02 &nbsp; Deine persönliche Ansicht</span><span>03 &nbsp; KI-Visualisierung · keine Passformmessung</span></div></div></section>
<section class="ay-related"><div class="ay-section-title"><h2>Dein nächster Look.</h2><span>WEITER ENTDECKEN ↗</span></div><div class="ay-grid" id="ay-products"></div></section>
{% else %}
<section class="ay-hero"><div class="ay-hero-copy"><p class="ay-eyebrow">THE PERSONAL EDITION / 2026</p><h1>Guter Stil.<br><em>Deine Perspektive.</em></h1><p>Entdecke eine Kollektion, die du schon vor dem ersten Anprobieren an dir sehen kannst.</p><button class="ay-primary" data-upload-open>Mach den Look zu deinem <span>↗</span></button><a class="ay-text-link" href="#collection">Kollektion entdecken ↓</a><div class="ay-hero-meta"><span>ONE PHOTO.</span><span>EVERY LOOK.</span><span>ALL YOU.</span></div></div><div class="ay-hero-image"><img id="ay-hero-image" alt="Die ATELIER Kollektion"><div class="ay-hero-caption"><span>01 / THE EVERYDAY EDIT</span><span>DESIGNED TO BE YOU.</span></div><div class="ay-floating-card"><span>✧</span><div>Das Model bist du.<small>Deine persönliche Anprobe</small></div></div></div></section>
<section id="collection" class="ay-collection"><div class="ay-section-title"><div><p class="ay-eyebrow">WENIGER SUCHEN. MEHR DU.</p><h2>Die Everyday Essentials.</h2></div><div class="ay-filters"><button class="active" data-filter="all">Alles</button><button data-filter="Outerwear">Outerwear</button><button data-filter="Knitwear">Knitwear</button><button data-filter="Essentials">Essentials</button><button data-filter="T-Shirts">T-Shirts</button><button data-filter="Trousers">Hosen</button><button data-filter="Footwear">Schuhe</button><button data-filter="Headwear">Caps</button></div></div><div class="ay-grid" id="ay-products"></div></section>
<section id="how" class="ay-how"><div><p class="ay-eyebrow">DEIN FOTO IST DER ANFANG.</p><h2>Einmal hochladen.<br>Immer du sein.</h2></div><ol><li><b>01</b><span>Dein Foto<small>Ein gut beleuchtetes Ganzkörperfoto.</small></span></li><li><b>02</b><span>Deine Auswahl<small>Entdecke deine Lieblingsstücke.</small></span></li><li><b>03</b><span>Dein Look<small>Sieh die Kollektion an dir.</small></span></li></ol></section>
{% endif %}
</main>
{% else %}{{ parent() }}{% endif %}
{% endblock %}
{% block base_footer %}<footer class="ay-footer"><a class="ay-logo" href="/">ATELIER<span>/ YOU</span></a><p>Fashion, seen differently.</p><small>Shopware × Qwen-Image-2.1 · Evaluationsprototyp</small></footer>{% endblock %}
{% block base_body_script %}{{ parent() }}
<dialog id="ay-upload"><button class="ay-close" aria-label="Schließen">×</button><p class="ay-eyebrow">THE PERSONAL EDITION</p><h2>Hier beginnt<br><em>dein Look.</em></h2><p>Wähle ein gut beleuchtetes Ganzkörperfoto von dir.</p><label class="ay-drop"><span>↑</span><strong>Foto auswählen</strong><small>JPG, PNG oder WebP · bis 12 MB</small><input id="ay-file" type="file" accept="image/jpeg,image/png,image/webp"></label><img id="ay-preview" alt="Dein ausgewähltes Foto" hidden><p class="ay-privacy">Dein Foto wird auf unserem eigenen Server verarbeitet und nach 24 Stunden automatisch gelöscht. Du kannst es jederzeit entfernen.</p><p id="ay-upload-error" role="alert"></p><button class="ay-primary" id="ay-start" disabled>Meine Anprobe starten <span>↗</span></button><button class="ay-delete" id="ay-delete" hidden>Mein Foto und meine Looks löschen</button></dialog><div id="ay-toast" role="status" hidden></div>
{% endblock %}

{% block base_cookie_permission %}{% endblock %}
