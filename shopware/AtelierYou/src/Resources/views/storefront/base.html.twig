{% sw_extends '@Storefront/storefront/base.html.twig' %}
{% block base_header %}
<div class="ay-announcement">THE NEW PERSPECTIVE &nbsp; · &nbsp; Your wardrobe starts with you.</div>
<header class="ay-header"><a class="ay-logo" href="/">ATELIER<span>/ YOU</span><small>PERSONAL EDITION</small></a><nav><a href="/#collection">The collection</a><a href="/?outfit=1">Outfit Studio <sup>NEW</sup></a><a href="/#how">How it works</a></nav><button class="ay-personal" data-upload-open><span class="ay-dot"></span><span data-profile-label>Your fitting room</span><span>↗</span></button></header>
{% endblock %}
{% block base_navigation %}{% endblock %}
{% block base_main %}
{% if page.product is defined or app.request.attributes.get('_route') == 'frontend.home.page' %}
<main id="content-main" class="ay-main" data-product-id="{{ page.product.id|default('') }}" data-outfit="{{ app.request.query.get('outfit') == '1' ? 'true' : 'false' }}">
{% if app.request.query.get('outfit') == '1' %}
<div class="ay-breadcrumb"><a href="/">Collection</a><span>/</span>Outfit Studio</div>
<section class="ay-pdp ay-outfit-studio"><div class="ay-product-visual"><img id="ay-main-image" alt="Your outfit"><img id="ay-incoming-image" alt="Your new outfit"><div class="ay-magic" aria-hidden="true"><div class="ay-magic-light"></div><div class="ay-magic-line"></div><i>✧</i><i>✧</i><i>✦</i></div><div class="ay-image-label"><span class="ay-dot"></span><span id="ay-image-state">YOUR OUTFIT STUDIO</span></div><button class="ay-compare" id="ay-compare" hidden>View original ↔</button><div class="ay-render-state" id="ay-render-state" hidden><span class="ay-spinner"></span><span>Creating your outfit …</span></div></div><div class="ay-product-info"><p class="ay-eyebrow">MORE THAN A SINGLE LOOK</p><h1>All together.<br>All you.</h1><p class="ay-description">Build your look. A top, the right trousers, your shoes — see everything on you, together.</p><div id="ay-outfit-selectors"></div><div class="ay-outfit-total"><span>Your outfit</span><b id="ay-outfit-price"></b></div><button class="ay-primary" id="ay-outfit-generate">See this outfit on me <span>✧</span></button><p class="ay-note" id="ay-personal-note">Choose up to five pieces for your look.</p><div class="ay-angles" id="ay-angles" hidden><p class="ay-small-title">YOUR OUTFIT · EVERY ANGLE</p><div><button class="selected" data-view="front">Front</button><button data-view="side">Side <span>✧</span></button><button data-view="back">Back <span>✧</span></button></div><small>Additional views are AI-generated interpretations.</small></div><p class="ay-note">Evaluation collection · AI visualization, not a fit measurement</p></div></section>
{% elseif page.product is defined %}
<div class="ay-breadcrumb"><a href="/">Collection</a><span>/</span>{{ page.product.translated.name }}</div>
<section class="ay-pdp"><div class="ay-product-visual"><img id="ay-main-image" src="{{ page.product.cover.media.url }}" alt="{{ page.product.translated.name }}"><img id="ay-incoming-image" alt="Your personal try-on"><div class="ay-magic" aria-hidden="true"><div class="ay-magic-light"></div><div class="ay-magic-line"></div><i>✧</i><i>✧</i><i>✦</i></div><div class="ay-image-label"><span class="ay-dot"></span><span id="ay-image-state">THE ORIGINAL</span></div><button class="ay-compare" id="ay-compare" hidden>View original ↔</button><div class="ay-render-state" id="ay-render-state" hidden><span class="ay-spinner"></span><span>Creating your look …</span></div></div>
<div class="ay-product-info"><p class="ay-eyebrow">ATELIER ESSENTIALS · EDITION 01</p><h1>{{ page.product.translated.name }}</h1><p class="ay-price">€{{ page.product.calculatedPrice.unitPrice|number_format(2, '.', ',') }}</p><p class="ay-description">{{ page.product.translated.description|striptags }}</p><div class="ay-divider"></div><p class="ay-small-title">YOUR PERSPECTIVE</p><button class="ay-try-button" data-upload-open><span>✧</span><span id="ay-try-label">See it on me</span><span>↗</span></button><p class="ay-note" id="ay-personal-note">One photo. The whole collection. All you.</p><p class="ay-small-title ay-size-title">SIZE <span>Demo collection</span></p><div class="ay-sizes"><button>S</button><button class="selected">M</button><button>L</button><button>XL</button></div><div class="ay-angles" id="ay-angles" hidden><p class="ay-small-title">YOUR LOOK · EVERY ANGLE</p><div><button class="selected" data-view="front">Front</button><button data-view="side">Side <span>✧</span></button><button data-view="back">Back <span>✧</span></button></div><small>Additional views are AI-generated interpretations.</small></div><div class="ay-shop-note">Shopware demo · Orders are disabled</div><div class="ay-benefits"><span>01 &nbsp; Timeless design</span><span>02 &nbsp; Your personal view</span><span>03 &nbsp; AI visualization · Not a fit measurement</span></div></div></section>
<section class="ay-related"><div class="ay-section-title"><h2>Your next look.</h2><span>KEEP EXPLORING ↗</span></div><div class="ay-grid" id="ay-products"></div></section>
{% else %}
<section class="ay-hero"><div class="ay-hero-copy"><p class="ay-eyebrow">THE PERSONAL EDITION / 2026</p><h1>Good style.<br><em>Your perspective.</em></h1><p>Discover a collection you can see on yourself before you try anything on.</p><button class="ay-primary" data-upload-open>Make the look yours <span>↗</span></button><a class="ay-text-link" href="#collection">Explore the collection ↓</a><div class="ay-hero-meta"><span>ONE PHOTO.</span><span>EVERY LOOK.</span><span>ALL YOU.</span></div></div><div class="ay-hero-image"><img id="ay-hero-image" alt="The ATELIER collection"><div class="ay-hero-caption"><span>01 / THE EVERYDAY EDIT</span><span>DESIGNED TO BE YOU.</span></div><div class="ay-floating-card"><span>✧</span><div>You are the model.<small>Your personal try-on</small></div></div></div></section>
<section id="collection" class="ay-collection"><div class="ay-section-title"><div><p class="ay-eyebrow">LESS SEARCHING. MORE YOU.</p><h2>The everyday essentials.</h2></div><div class="ay-filters"><button class="active" data-filter="all">All</button><button data-filter="Outerwear">Outerwear</button><button data-filter="Knitwear">Knitwear</button><button data-filter="Essentials">Essentials</button><button data-filter="T-Shirts">T-Shirts</button><button data-filter="Trousers">Trousers</button><button data-filter="Footwear">Shoes</button><button data-filter="Headwear">Caps</button></div></div><div class="ay-grid" id="ay-products"></div></section>
<section id="how" class="ay-how"><div><p class="ay-eyebrow">IT STARTS WITH YOUR PHOTO.</p><h2>Upload once.<br>Always you.</h2></div><ol><li><b>01</b><span>Your photo<small>A well-lit, full-length photo.</small></span></li><li><b>02</b><span>Your selection<small>Discover your favourite pieces.</small></span></li><li><b>03</b><span>Your look<small>See the collection on you.</small></span></li></ol></section>
{% endif %}
</main>
{% else %}{{ parent() }}{% endif %}
{% endblock %}
{% block base_footer %}<footer class="ay-footer"><a class="ay-logo" href="/">ATELIER<span>/ YOU</span></a><p>Fashion, seen differently.</p><small>Shopware × Qwen-Image-2.1 · Evaluation prototype</small></footer>{% endblock %}
{% block base_body_script %}{{ parent() }}
<dialog id="ay-upload"><button class="ay-close" aria-label="Close">×</button><p class="ay-eyebrow">THE PERSONAL EDITION</p><h2>Your look<br><em>starts here.</em></h2><p>Choose a well-lit, full-length photo of yourself.</p><label class="ay-drop"><span>↑</span><strong>Choose a photo</strong><small>JPG, PNG or WebP · up to 12 MB</small><input id="ay-file" type="file" accept="image/jpeg,image/png,image/webp"></label><img id="ay-preview" alt="Your selected photo" hidden><p class="ay-privacy">Your photo is processed on our own server and automatically deleted after 24 hours. You can remove it at any time.</p><p id="ay-upload-error" role="alert"></p><button class="ay-primary" id="ay-start" disabled>Start my try-on <span>↗</span></button><button class="ay-delete" id="ay-delete" hidden>Delete my photo and looks</button></dialog><div id="ay-toast" role="status" hidden></div>
{% endblock %}

{% block base_cookie_permission %}{% endblock %}
